# --- Server ---
PORT=2567
CLIENT_URL=http://localhost:5173
APP_VERSION=0.1.0
# Prod: starkes Secret in GitHub Secrets/Env setzen (nie committen).
JWT_SECRET=dev-secret-change-me
BOTS_ENABLED=true

# --- DB (ab M4 benutzt, schon dokumentiert damit Compose/CI dieselben Namen nutzen) ---
# Free-Hosting ohne DB: DB_ENABLED=false setzen (Memory-Modus, Spiel voll nutzbar,
# /leaderboard antwortet dann 503). Mit DB: DB_ENABLED=true + URLs setzen.
DB_ENABLED=true
DATABASE_URL=postgresql://neon:neon@localhost:5432/neon_arena
REDIS_URL=redis://localhost:6379

# --- Cookie (nur Free-Hosting mit getrennten Domains relevant) ---
# Prod (Render + Pages): "none" (Default in production) – noetig fuer Cross-Site-Cookie.
# Lokal: "lax" (Default ausserhalb production).
COOKIE_SAMESITE=

# --- Client ---
VITE_SERVER_URL=http://localhost:2567
VITE_PROTOCOL_V=1
