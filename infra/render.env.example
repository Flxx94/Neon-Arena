# Render Free – Umgebungsvariablen fuer den Neon-Arena-Server
# Dashboard: Service -> Environment -> diese Werte setzen (Alternative zum Blueprint infra/render.yaml).
# Niemals committen, nur als Vorlage. JWT_SECRET per Zufall erzeugen:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Pflicht
NODE_ENV=production
# PORT wird von Render automatisch injiziert – NICHT selbst setzen.
CLIENT_URL=https://DEIN-PROJEKT.pages.dev
JWT_SECRET=HIER-STARKES-SECRET-EINTRAGEN
APP_VERSION=0.1.0
BOTS_ENABLED=true

# Free-Start ohne DB (empfohlen): Memory-Modus, keine Migration, Spiel voll nutzbar.
# /leaderboard und /history antworten dann 503 ("Bestenliste offline").
DB_ENABLED=false
# DATABASE_URL und REDIS_URL bewusst LEER lassen (nicht setzen).
# COOKIE_SAMESITE leer lassen -> Prod-Default "none" (Cross-Site Pages<->Render).

# --- Alternative MIT DB (Render Postgres + Upstash Redis), nur wenn Bestenliste gewuenscht: ---
# DB_ENABLED=true
# DATABASE_URL=postgresql://USER:PASS@HOST/neon_arena?sslmode=require
# REDIS_URL=rediss://default:PASS@HOST:6379
