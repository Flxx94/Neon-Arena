FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/server ./apps/server
RUN pnpm install --frozen-lockfile=false && pnpm --filter @neon-arena/shared build && pnpm --filter @neon-arena/server exec prisma generate && pnpm --filter @neon-arena/server build

# M0: kompletter Workspace inkl. pnpm-node_modules wird uebernommen (Symlinks bleiben erhalten).
# TODO(M5): Runtime-Image verschlanken (pnpm deploy / prod-only install).
FROM node:22-alpine
WORKDIR /app
COPY --from=build /app ./
COPY infra/start-server.sh ./infra/start-server.sh
RUN chmod +x ./infra/start-server.sh
ENV NODE_ENV=production
ENV PORT=2567
EXPOSE 2567
CMD ["sh", "./infra/start-server.sh"]
