+          ctx.save()
+          ctx.translate(p.x, p.y)
+          ctx.rotate(p.rot)
+          ctx.fillStyle = '#fffbe0'
+          ctx.beginPath()
+          const s = p.size * (0.6 + (1 - k) * 0.6)
+          ctx.moveTo(s, 0)
+          ctx.lineTo(0, s * 0.32)
+          ctx.lineTo(-s * 0.35, 0)
+          ctx.lineTo(0, -s * 0.32)
+          ctx.closePath()
+          ctx.fill()
+          ctx.fillStyle = p.color
+          ctx.beginPath()
+          ctx.arc(0, 0, s * 0.3, 0, Math.PI * 2)
+          ctx.fill()
+          ctx.restore()
+          break
+        }
+        case 'streak': {
+          ctx.globalAlpha = k
+          ctx.strokeStyle = p.color
+          ctx.lineWidth = p.size
+          ctx.lineCap = 'round'
+          ctx.beginPath()
+          ctx.moveTo(p.x, p.y)
+          ctx.lineTo(p.x - p.vx * 0.04, p.y - p.vy * 0.04)
+          ctx.stroke()
+          break
+        }
+        case 'shard':
+        case 'confetti': {
+          ctx.globalAlpha = p.kind === 'confetti' ? Math.min(1, k * 2) : k
+          ctx.save()
+          ctx.translate(p.x, p.y)
+          ctx.rotate(p.rot)
+          ctx.fillStyle = p.color
+          const s = p.size * (p.kind === 'confetti' ? 1 : 0.6 + k * 0.4)
+          if (p.kind === 'confetti') {
+            ctx.scale(1, Math.abs(Math.cos(p.rot * 1.7)) * 0.9 + 0.1)
+            ctx.fillRect(-s / 2, -s / 3, s, (s * 2) / 3)
+          } else {
+            ctx.beginPath()
+            ctx.moveTo(s, 0)
+            ctx.lineTo(-s * 0.6, s * 0.7)
+            ctx.lineTo(-s * 0.6, -s * 0.7)
+            ctx.closePath()
+            ctx.fill()
+            ctx.strokeStyle = pal.ink
+            ctx.lineWidth = 1
+            ctx.stroke()
+          }
+          ctx.restore()
+          break
+        }
+        default: {
+          // 'dot': additiv im dunklen Theme = Leuchtfunke
+          if (additive) ctx.globalCompositeOperation = 'lighter'
+          ctx.globalAlpha = k
+          ctx.fillStyle = p.color
+          ctx.beginPath()
+          ctx.arc(p.x, p.y, Math.max(0.4, p.size * (0.4 + k * 0.6)), 0, Math.PI * 2)
+          ctx.fill()
+          ctx.globalCompositeOperation = 'source-over'
+        }
+      }
+    }
+    ctx.globalAlpha = 1
+  }
+
+  /** Schwebende Texte (ueber allem). */
+  drawTexts(ctx: CanvasRenderingContext2D, pal: Palette): void {
+    ctx.textAlign = 'center'
+    ctx.textBaseline = 'middle'
+    ctx.lineJoin = 'round'
+    for (const t of this.texts) {
+      const k = t.life / t.max
+      const pop = k > 0.82 ? 1 + (k - 0.82) * 4 : 1
+      ctx.globalAlpha = Math.min(1, k * 2.2)
+      ctx.font = `800 ${t.size * pop}px ${FONT}`
+      ctx.lineWidth = 4.5
+      ctx.strokeStyle = pal.ink
+      ctx.strokeText(t.text, t.x, t.y)
+      ctx.fillStyle = t.color
+      ctx.fillText(t.text, t.x, t.y)
+    }
+    ctx.globalAlpha = 1
+  }
+}
