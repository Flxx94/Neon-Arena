+      p.vx *= k
+      p.vy *= k
+      if (p.kind === 'confetti') p.vy += gravity * 0.5 * dt
+      if (p.kind === 'smoke') p.vy -= 18 * dt
+      p.x += p.vx * dt
+      p.y += p.vy * dt
+      p.rot += p.vr * dt
