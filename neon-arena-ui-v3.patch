+      this.add({
+        kind: i % 3 === 0 ? 'shard' : 'dot',
+        x,
+        y,
+        vx: Math.cos(a) * sp,
+        vy: Math.sin(a) * sp,
+        life: this.rand(0.25, 0.5),
+        max: 0.5,
