{
  "name": "@neon-arena/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "echo \"no e2e in server\""
  },
  "dependencies": {
    "@colyseus/core": "0.16.20",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "0.16.5",
    "@neon-arena/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "colyseus.js": "^0.16.22",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
