generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Gaeste (M4-02) und Accounts (Email + Passwort, ADR-005). Gaeste haben email/passwordHash = NULL.
model User {
  id           String        @id @default(uuid())
  nickname     String
  isGuest      Boolean       @default(true)
  email        String?       @unique
  passwordHash String?
  skin         Int           @default(0)
  createdAt    DateTime      @default(now())
  matches      MatchPlayer[]
}

model Match {
  id        String        @id @default(uuid())
  roomId    String
  startedAt DateTime      @default(now())
  endedAt   DateTime      @default(now())
  winnerId  String?
  players   MatchPlayer[]
}

model MatchPlayer {
  matchId String
  userId  String
  kills   Int    @default(0)
  deaths  Int    @default(0)
  score   Int    @default(0)
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, userId])
}
