generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Spielerprofil pro IP (ADR-014): nickname = Anzeigename, ip = normalisierte Adresse (personenbezogen!).
// email/passwordHash/isGuest sind Altlasten der entfernten Konten und bleiben der Kompatibilitaet halber.
model User {
  id           String        @id @default(uuid())
  nickname     String
  isGuest      Boolean       @default(true)
  email        String?       @unique
  passwordHash String?
  skin         Int           @default(0)
  ip           String?
  createdAt    DateTime      @default(now())
  matches      MatchPlayer[]

  @@index([ip])
}

model Match {
  id        String        @id @default(uuid())
  roomId    String
  startedAt DateTime      @default(now())
  endedAt   DateTime      @default(now())
  winnerId  String?
  players   MatchPlayer[]
}

model MatchPlayer {
  matchId String
  userId  String
  kills   Int    @default(0)
  deaths  Int    @default(0)
  score   Int    @default(0)
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, userId])
}
